+5t_ota - single-file nine-metric ngspice testbench
+* ============================================================
+* Run: ngspice -b 5t_ota_all_metrics.cir
+* Output: 5t_ota_metrics.txt, in the current working directory.
+* The output has one CSV header and one row, although its suffix is .txt.
+* DUT and its 8 design parameters are embedded below; no params.sp needed.
+* DC operating point: XDUT_CM, one quiet voltage-follower instance.
+* Also keep 5t_ota_export_excel.py in the current working directory.
+* Excel export needs Python 3 and openpyxl: python3 -m pip install openpyxl
+* Additional outputs: 5t_ota_dc_operating_point.raw/.csv and 5t_ota_results.xlsx.
+* The PDK remains external. Raw DC data is saved before AC/transient analysis.
+* Edit the PDK path, TEST CONDITIONS and DESIGN PARAMETERS before use.
+* Example dimensions below are not a verified golden point.
+*
+* Metric definitions follow the repository's single-ended-opamp benches:
+* gain: inverting-input AC injection, corrected for input sign, at 1 Hz;
+* UGF/PM: first falling unity-loop-gain crossing in the SAME AC sweep;
+* CMRR: reconstructed |ADM/ACM|, at 1 Hz;
+* PSRR: unity-follower rail rejection, at 1 Hz (repository convention);
+* SR: average 10%-90% settled OUTPUT transition slope, positive V/us;
+* power: DC rail power of ONE quiet follower instance, in uW.
+* Missing crossings/transitions are written as nan, never as zero.
+* Negative dB values and negative phase margins are retained.
+* ============================================================
+
+.param mc_mm_switch=0 mc_pr_switch=0
+.lib "/share/home/202411094934/python_project/pdk/sky130A/libs.tech/ngspice/sky130.lib.spice" tt
+.option scale=1u
+.options numdgt=15
+.temp 27
+
+* --------------------- TEST CONDITIONS -----------------------
+* W/L use um, current uses A, capacitor value uses F.
+.param SUPPLY_VDD=1.8 SUPPLY_VSS=0.0 INPUT_VCM=0.72 LOAD_C=1p
+.param AC_DENSITY=100 AC_START_HZ=0.1 AC_STOP_HZ=50e9 REF_HZ=1
+.param SR_LOW=0.7 SR_HIGH=1.1 SR_DELAY=1u
+.param SR_INPUT_TR=1n SR_INPUT_TF=1n SR_WIDTH=4u SR_PERIOD=10u
+.param TRAN_STEP=1n TRAN_STOP=12u TRAN_MAX_STEP=1n
+.param LOW_AVG_START=0.2u LOW_AVG_STOP=0.8u
+.param HIGH_AVG_START=3u HIGH_AVG_STOP=4u
+.param RISE_WINDOW_START=0.9u RISE_WINDOW_END=4.9u
+.param FALL_WINDOW_START=4.9u FALL_WINDOW_END=10.9u
+.param MIN_OUTPUT_SWING=1e-6
+
+* Copy .param values into control-language constants.
+.csparam cfg_ac_density={AC_DENSITY}
+.csparam cfg_ac_start={AC_START_HZ}
+.csparam cfg_ac_stop={AC_STOP_HZ}
+.csparam cfg_ref_hz={REF_HZ}
+.csparam cfg_tran_step={TRAN_STEP}
+.csparam cfg_tran_stop={TRAN_STOP}
+.csparam cfg_tran_max_step={TRAN_MAX_STEP}
+.csparam cfg_low_start={LOW_AVG_START}
+.csparam cfg_low_stop={LOW_AVG_STOP}
+.csparam cfg_high_start={HIGH_AVG_START}
+.csparam cfg_high_stop={HIGH_AVG_STOP}
+.csparam cfg_rise_start={RISE_WINDOW_START}
+.csparam cfg_rise_end={RISE_WINDOW_END}
+.csparam cfg_fall_start={FALL_WINDOW_START}
+.csparam cfg_fall_end={FALL_WINDOW_END}
+.csparam cfg_min_swing={MIN_OUTPUT_SWING}
+
+* -------------------- DESIGN PARAMETERS ----------------------
+* Source: analog-agent/Sample_Optimizer_Circuit/5t_ota/
+* Source revision: 6a1363ef6be90905c52dde54e39f59df258c1ee5
+* Standalone snapshot: edit parameters HERE to change this test.
+* Source defaults retained; not a simulation-verified operating point.
+* Five-transistor OTA design parameters.
+* IBIAS_A: A; W/L: um; M_FACTOR: positive integer multiplicity.
+
+.param IBIAS_A=10e-6
+.param WBIAS=8
+.param LBIAS=0.5
+.param WIN=20
+.param LIN=0.5
+.param WLOAD=40
+.param LLOAD=0.5
+.param M_FACTOR=1
+
+* Resolved numeric inputs for the DC export; do not edit these aliases.
+.csparam export_ibias_a={IBIAS_A}
+.csparam export_wbias={WBIAS}
+.csparam export_lbias={LBIAS}
+.csparam export_win={WIN}
+.csparam export_lin={LIN}
+.csparam export_wload={WLOAD}
+.csparam export_lload={LLOAD}
+.csparam export_m_factor={M_FACTOR}
+.csparam export_supply_vdd={SUPPLY_VDD}
+.csparam export_supply_vss={SUPPLY_VSS}
+.csparam export_input_vcm={INPUT_VCM}
+.csparam export_load_c={LOAD_C}
+.csparam export_ac_density={AC_DENSITY}
+.csparam export_ac_start_hz={AC_START_HZ}
+.csparam export_ac_stop_hz={AC_STOP_HZ}
+.csparam export_ref_hz={REF_HZ}
+.csparam export_sr_low={SR_LOW}
+.csparam export_sr_high={SR_HIGH}
+
+* DUT uses LVT models; connectivity and sizing expressions match the source.
+.subckt DUT VINP VINN VOUT VDD VSS
+
+* Internal bias circuit corresponding to Cadence MNM3 and II0.
+IBIAS_SRC VDD N_BIAS DC {IBIAS_A}
+XMBIAS N_BIAS N_BIAS VSS VSS sky130_fd_pr__nfet_01v8_lvt L={LBIAS} W={WBIAS} m=1
+
+* Tail current mirror corresponding to Cadence MNM2.
+* It shares W/L with the diode-connected bias NMOS.
+XMTAIL NTAIL N_BIAS VSS VSS sky130_fd_pr__nfet_01v8_lvt L={LBIAS} W={WBIAS} m={2*M_FACTOR}
+
+* NMOS differential pair corresponding to Cadence MNM0/MNM1.
+XMN_INP N1 VINP NTAIL VSS sky130_fd_pr__nfet_01v8_lvt L={LIN} W={WIN} m={M_FACTOR}
+XMN_INN VOUT VINN NTAIL VSS sky130_fd_pr__nfet_01v8_lvt L={LIN} W={WIN} m={M_FACTOR}
+
+* PMOS current-mirror load corresponding to Cadence MPM0/MPM1.
+XMP_DIODE N1 N1 VDD VDD sky130_fd_pr__pfet_01v8_lvt L={LLOAD} W={WLOAD} m={M_FACTOR}
+XMP_OUT VOUT N1 VDD VDD sky130_fd_pr__pfet_01v8_lvt L={LLOAD} W={WLOAD} m={M_FACTOR}
+
+.ends DUT
+
+* -------- AC GAIN / UGF / PM: DC feedback, AC injection --------
+VDD_DM VDD_DM 0 DC {SUPPLY_VDD}
+VSS_DM VSS_DM 0 DC {SUPPLY_VSS}
+VINP_DM INP_DM 0 DC {INPUT_VCM}
+VINJ_DM SIGNAL_DM 0 DC {INPUT_VCM} AC 1
+LFB_DM OUT_DM INN_DM 1T
+CINJ_DM INN_DM SIGNAL_DM 1T
+XDUT_DM INP_DM INN_DM OUT_DM VDD_DM VSS_DM DUT
+CLOAD_DM OUT_DM VSS_DM {LOAD_C}
+
+* -------- CMRR: common-mode injection in a DC follower ---------
+* This instance also supplies the single-DUT DC power measurement.
+VDD_Q VDD_Q 0 DC {SUPPLY_VDD}
+VSS_Q VSS_Q 0 DC {SUPPLY_VSS}
+VCM_Q CM_DC 0 DC {INPUT_VCM}
+VCMAC_P INP_CM CM_DC DC 0 AC 1
+VCMAC_N INN_CM OUT_CM DC 0 AC 1
+XDUT_CM INP_CM INN_CM OUT_CM VDD_Q VSS_Q DUT
+CLOAD_CM OUT_CM VSS_Q {LOAD_C}
+
+* ------------------ POSITIVE-SUPPLY PSRR ----------------------
+VDD_P VDD_P 0 DC {SUPPLY_VDD} AC 1
+VSS_P VSS_P 0 DC {SUPPLY_VSS}
+VINP_P INP_P 0 DC {INPUT_VCM}
+XDUT_P INP_P OUT_P OUT_P VDD_P VSS_P DUT
+CLOAD_P OUT_P 0 {LOAD_C}
+
+* ------------------ NEGATIVE-SUPPLY PSRR ----------------------
+VDD_N VDD_N 0 DC {SUPPLY_VDD}
+VSS_N VSS_N 0 DC {SUPPLY_VSS} AC 1
+VINP_N INP_N 0 DC {INPUT_VCM}
+XDUT_N INP_N OUT_N OUT_N VDD_N VSS_N DUT
+CLOAD_N OUT_N 0 {LOAD_C}
+
+* ------------------ TRANSIENT SLEW RATE -----------------------
+VDD_SR VDD_SR 0 DC {SUPPLY_VDD}
+VSS_SR VSS_SR 0 DC {SUPPLY_VSS}
+VIN_SR IN_SR 0 DC {INPUT_VCM} PULSE({SR_LOW} {SR_HIGH} {SR_DELAY} {SR_INPUT_TR} {SR_INPUT_TF} {SR_WIDTH} {SR_PERIOD})
+XDUT_SR IN_SR OUT_SR OUT_SR VDD_SR VSS_SR DUT
+RLOAD_SR OUT_SR 0 1T
+CLOAD_SR OUT_SR 0 {LOAD_C}
+
+.control
+set noaskquit
+set units=radians
+set numdgt=15
+option numdgt=15
+set result_file=5t_ota_metrics.txt
+set m_gain=nan
+set m_ugf=nan
+set m_pm=nan
+set m_cmrr=nan
+set m_psrr_plus=nan
+set m_psrr_minus=nan
+set m_slew_rise=nan
+set m_slew_fall=nan
+set m_power=nan
+
+* Create a result immediately; subsequent stages overwrite the result row.
+echo "DC_Gain_dB,UGF_Hz,Phase_Margin_deg,CMRR_dB,PSRR_Plus_dB,PSRR_Minus_dB,Slew_Rise_V_us,Slew_Fall_V_us,Power_Quiescent_uW" > $result_file
+echo "$m_gain,$m_ugf,$m_pm,$m_cmrr,$m_psrr_plus,$m_psrr_minus,$m_slew_rise,$m_slew_fall,$m_power" >> $result_file
+
+* Quiescent power: VDD_Q/VSS_Q feed only XDUT_CM, not all DUT copies.
+op
+let power_uw=-(v(VDD_Q)*i(VDD_Q)+v(VSS_Q)*i(VSS_Q))*1e6
+set m_power=$&power_uw
+let follower_error_v=v(OUT_CM)-v(INP_CM)
+let dm_cm_bias_difference_v=v(OUT_DM)-v(OUT_CM)
+print power_uw follower_error_v dm_cm_bias_difference_v
+
+
