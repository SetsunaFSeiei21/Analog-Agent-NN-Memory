+        ],
+        [
+            "DC snapshot",
+            "Power_Quiescent",
+            required("power_uw"),
+            "uW",
+            "One DUT instance only",
+        ],
+    ]
+
+    for name, unit in CONDITIONS:
+        setup_rows.append(
+            [
+                "Test condition",
+                name,
+                required("op_input_" + name.lower()),
+                unit,
+                "",
+            ]
+        )
+
+    temp = re.search(
+        r"(?im)^\s*\.temp\s+([-+\d.eE]+)",
+        netlist_text,
+    )
+
+    if temp:
