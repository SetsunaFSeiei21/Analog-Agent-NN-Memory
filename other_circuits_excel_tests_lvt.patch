+
+* DUT uses LVT models; connectivity and sizing expressions match the source.
+.subckt DUT VINP VINN VOUT VDD VSS
+
+* Internal PMOS bias branch corresponding to Cadence MPM1 and II0.
+* The reference current flows from VBP1 to VSS and is a design variable.
+IBIAS_SRC VBP1 VSS DC {IBIAS_A}
+XMP_BIAS_REF VBP1 VBP1 VDD VDD sky130_fd_pr__pfet_01v8_lvt L={LPBIAS} W={WPBIAS} m=1
+
+* Additional PMOS bias devices corresponding to Cadence MPM0/MPM4.
+XMP_VB3 VB3 VBP1 VDD VDD sky130_fd_pr__pfet_01v8_lvt L={LPBIAS} W={WPBIAS} m=1
+XMP_VB2 VB2 VBP1 VDD VDD sky130_fd_pr__pfet_01v8_lvt L={LPBIAS} W={WPBIAS} m=1
+
+* PMOS bias stack corresponding to Cadence MPM2/MPM3.
+XMP_PCAS_DIODE VB1 VB1 N_PBIAS VDD sky130_fd_pr__pfet_01v8_lvt L={LPCAS_BIAS} W={WPCAS_BIAS} m=1
+XMP_PCAS_SOURCE N_PBIAS VB1 VDD VDD sky130_fd_pr__pfet_01v8_lvt L={LPCAS_BIAS} W={WPCAS_BIAS} m=1
+
+* NMOS bias devices corresponding to Cadence MNM0/MNM1.
+XMN_BIAS_REF VB3 VB3 VSS VSS sky130_fd_pr__nfet_01v8_lvt L={LNBIAS} W={WNBIAS} m=1
+XMN_VB1 VB1 VB3 VSS VSS sky130_fd_pr__nfet_01v8_lvt L={LNBIAS} W={WNBIAS} m=1
+
+* NMOS cascode-bias stack corresponding to Cadence MNM2/MNM3.
+XMN_NCAS_DIODE VB2 VB2 N_NBIAS VSS sky130_fd_pr__nfet_01v8_lvt L={LNCAS_BIAS} W={WNCAS_BIAS} m=1
+XMN_NCAS_SOURCE N_NBIAS VB2 VSS VSS sky130_fd_pr__nfet_01v8_lvt L={LNCAS_BIAS} W={WNCAS_BIAS} m=1
+
+* PMOS input-pair tail source corresponding to Cadence MPM5.
+XMP_INPUT_TAIL N_INPUT_TAIL VBP1 VDD VDD sky130_fd_pr__pfet_01v8_lvt L={LPBIAS} W={WPBIAS} m={2*M1_FACTOR}
+
+* PMOS differential pair corresponding to Cadence MPM6/MPM7.
+XMP_INN N_FOLD_N VINN N_INPUT_TAIL VDD sky130_fd_pr__pfet_01v8_lvt L={LIN} W={WIN} m={M1_FACTOR}
+XMP_INP N_FOLD_P VINP N_INPUT_TAIL VDD sky130_fd_pr__pfet_01v8_lvt L={LIN} W={WIN} m={M1_FACTOR}
+
+* PMOS folded branches corresponding to Cadence MPM8/MPM9.
+XMP_FOLD_P N_PCAS_P N_PCAS_GATE VDD VDD sky130_fd_pr__pfet_01v8_lvt L={LPFOLD} W={WPFOLD} m={M1_FACTOR}
+XMP_FOLD_N N_PCAS_N N_PCAS_GATE VDD VDD sky130_fd_pr__pfet_01v8_lvt L={LPFOLD} W={WPFOLD} m={M1_FACTOR}
+
+* PMOS cascodes corresponding to Cadence MPM10/MPM11.
+XMP_CAS_P OTA_OUT VB1 N_PCAS_P VDD sky130_fd_pr__pfet_01v8_lvt L={LPCAS} W={WPCAS} m={M1_FACTOR}
+XMP_CAS_N N_PCAS_GATE VB1 N_PCAS_N VDD sky130_fd_pr__pfet_01v8_lvt L={LPCAS} W={WPCAS} m={M1_FACTOR}
+
+* NMOS sink devices corresponding to Cadence MNM5/MNM7.
+XMN_SINK_P N_FOLD_P VB3 VSS VSS sky130_fd_pr__nfet_01v8_lvt L={LNBIAS} W={WNBIAS} m={2*M1_FACTOR}
+XMN_SINK_N N_FOLD_N VB3 VSS VSS sky130_fd_pr__nfet_01v8_lvt L={LNBIAS} W={WNBIAS} m={2*M1_FACTOR}
+
+* NMOS cascodes corresponding to Cadence MNM4/MNM6.
+XMN_CAS_P OTA_OUT VB2 N_FOLD_P VSS sky130_fd_pr__nfet_01v8_lvt L={LNCAS} W={WNCAS} m={M1_FACTOR}
+XMN_CAS_N N_PCAS_GATE VB2 N_FOLD_N VSS sky130_fd_pr__nfet_01v8_lvt L={LNCAS} W={WNCAS} m={M1_FACTOR}
+
+* Second stage corresponding to Cadence MPM12/MNM8.
+XMP_STAGE2 VOUT OTA_OUT VDD VDD sky130_fd_pr__pfet_01v8_lvt L={L2P} W={W2P} m={M1_FACTOR*M2_FACTOR}
+XMN_STAGE2 VOUT VB3 VSS VSS sky130_fd_pr__nfet_01v8_lvt L={LNBIAS} W={WNBIAS} m={M1_FACTOR*M2_FACTOR}
+
+* Miller compensation corresponding to Cadence RR0/CC0.
+RNULL OTA_OUT COMP {RNULL_OHM}
+CCOMP COMP VOUT {CCOMP_F}
+
+.ends DUT
+
+* -------- AC GAIN / UGF / PM: DC feedback, AC injection --------
+VDD_DM VDD_DM 0 DC {SUPPLY_VDD}
+VSS_DM VSS_DM 0 DC {SUPPLY_VSS}
+VINP_DM INP_DM 0 DC {INPUT_VCM}
+VINJ_DM SIGNAL_DM 0 DC {INPUT_VCM} AC 1
+LFB_DM OUT_DM INN_DM 1T
+CINJ_DM INN_DM SIGNAL_DM 1T
+XDUT_DM INP_DM INN_DM OUT_DM VDD_DM VSS_DM DUT
+CLOAD_DM OUT_DM VSS_DM {LOAD_C}
+
+* -------- CMRR: common-mode injection in a DC follower ---------
+* This instance also supplies the single-DUT DC power measurement.
+VDD_Q VDD_Q 0 DC {SUPPLY_VDD}
+VSS_Q VSS_Q 0 DC {SUPPLY_VSS}
+VCM_Q CM_DC 0 DC {INPUT_VCM}
+VCMAC_P INP_CM CM_DC DC 0 AC 1
+VCMAC_N INN_CM OUT_CM DC 0 AC 1
+XDUT_CM INP_CM INN_CM OUT_CM VDD_Q VSS_Q DUT
+CLOAD_CM OUT_CM VSS_Q {LOAD_C}
+
+* ------------------ POSITIVE-SUPPLY PSRR ----------------------
+VDD_P VDD_P 0 DC {SUPPLY_VDD} AC 1
+VSS_P VSS_P 0 DC {SUPPLY_VSS}
+VINP_P INP_P 0 DC {INPUT_VCM}
+XDUT_P INP_P OUT_P OUT_P VDD_P VSS_P DUT
+CLOAD_P OUT_P 0 {LOAD_C}
+
+* ------------------ NEGATIVE-SUPPLY PSRR ----------------------
+VDD_N VDD_N 0 DC {SUPPLY_VDD}
+VSS_N VSS_N 0 DC {SUPPLY_VSS} AC 1
+VINP_N INP_N 0 DC {INPUT_VCM}
+XDUT_N INP_N OUT_N OUT_N VDD_N VSS_N DUT
+CLOAD_N OUT_N 0 {LOAD_C}
+
+* ------------------ TRANSIENT SLEW RATE -----------------------
+VDD_SR VDD_SR 0 DC {SUPPLY_VDD}
+VSS_SR VSS_SR 0 DC {SUPPLY_VSS}
+VIN_SR IN_SR 0 DC {INPUT_VCM} PULSE({SR_LOW} {SR_HIGH} {SR_DELAY} {SR_INPUT_TR} {SR_INPUT_TF} {SR_WIDTH} {SR_PERIOD})
+XDUT_SR IN_SR OUT_SR OUT_SR VDD_SR VSS_SR DUT
+RLOAD_SR OUT_SR 0 1T
+CLOAD_SR OUT_SR 0 {LOAD_C}
+
+.control
+set noaskquit
+set units=radians
+set numdgt=15
