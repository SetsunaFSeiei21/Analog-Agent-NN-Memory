+                "",
+            ]
+        )
+
+    pdk = re.search(
+        r'(?im)^\s*\.lib\s+"([^"]+)"\s+(\S+)',
+        netlist_text,
+    )
+
+    if pdk:
+        setup_rows.extend(
+            [
+                [
+                    "Test condition",
+                    "PDK_PATH",
+                    pdk.group(1),
