+
+
+def atomic_csv(path: Path, header, rows):
+    path.parent.mkdir(
+        parents=True,
+        exist_ok=True,
+    )
+
+    fd, temporary = tempfile.mkstemp(
+        prefix=path.name + ".",
+        suffix=".tmp",
+        dir=path.parent,
+    )
+
+    try:
+        with os.fdopen(
+            fd,
+            "w",
+            newline="",
+            encoding="utf-8-sig",
+        ) as handle:
+            writer = csv.writer(handle)
+            writer.writerow(header)
+            writer.writerows(rows)
+
+        os.replace(temporary, path)
+
+    finally:
+        if os.path.exists(temporary):
+            os.unlink(temporary)
+
+
+def write_wide_csv(path: Path, payload):
+    header = ["DC_Instance"]
+    values = ["XDUT_CM"]
+
+    for row, cap in zip(
+        payload["dc_rows"],
+        payload["cap_rows"],
+    ):
+        for field, value in zip(
+            payload["dc_headers"][7:],
+            row[7:],
+        ):
+            header.append(row[0] + "__" + field)
+            values.append(value)
+
+        for field, value in zip(
+            payload["cap_headers"][3:],
+            cap[3:],
+        ):
+            header.append(row[0] + "__" + field)
+            values.append(value)
+
+    atomic_csv(
+        path,
+        header,
+        [values],
+    )
+
+
