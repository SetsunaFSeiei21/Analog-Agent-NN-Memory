+let op_xmn_stage2_cbb=@m.xdut_cm.xmn_stage2.msky130_fd_pr__nfet_01v8_lvt[cbb]
+let op_xmn_stage2_capbd=@m.xdut_cm.xmn_stage2.msky130_fd_pr__nfet_01v8_lvt[capbd]
+let op_xmn_stage2_capbs=@m.xdut_cm.xmn_stage2.msky130_fd_pr__nfet_01v8_lvt[capbs]
+let op_xmn_stage2_qg=@m.xdut_cm.xmn_stage2.msky130_fd_pr__nfet_01v8_lvt[qg]
+let op_xmn_stage2_qb=@m.xdut_cm.xmn_stage2.msky130_fd_pr__nfet_01v8_lvt[qb]
+let op_xmn_stage2_qd=@m.xdut_cm.xmn_stage2.msky130_fd_pr__nfet_01v8_lvt[qd]
+let op_xmn_stage2_qs=@m.xdut_cm.xmn_stage2.msky130_fd_pr__nfet_01v8_lvt[qs]
+
+* Full precision is kept in this ASCII raw file, not in echo-expanded strings.
+write two_stage_folded_opamp_dc_operating_point.raw all
+echo DC operating point saved to two_stage_folded_opamp_dc_operating_point.raw
+* Free the exported snapshot before AC/tran; configured constants survive.
+* No subsequent metric calculation needs a live DC vector from this plot.
+destroy $curplot
+
+* One AC sweep supplies every AC metric; UGF and PM share one crossing.
+ac dec $&cfg_ac_density $&cfg_ac_start $&cfg_ac_stop
+let inverting_gain=-v(OUT_DM)/v(INN_DM)
+let gain_mag=mag(inverting_gain)
+let phase_deg=180/pi*cph(inverting_gain)
+let phase_origin=phase_deg[0]
+* Anchor the continuous phase near its low-frequency branch.
+while phase_origin > 180
+    let phase_deg=phase_deg-360
+    let phase_origin=phase_origin-360
+end
+while phase_origin < -180
+    let phase_deg=phase_deg+360
+    let phase_origin=phase_origin+360
+end
+meas ac gain_ref_mag FIND gain_mag AT=$&cfg_ref_hz
+if gain_ref_mag > 0
+    let dc_gain_db=20*log10(gain_ref_mag)
+    set m_gain=$&dc_gain_db
+else
+    set m_gain=-inf
+end
+
+* Find the first FALLING crossing, then interpolate BOTH metrics in log(f).
+* This avoids attempting meas on a missing crossing and preserves nan.
+let ac_index=1
+let first_fall=-1
+let falling_crossings=0
+let ac_count=length(frequency)
+while ac_index < ac_count
+    if gain_mag[ac_index-1] >= 1
+        if gain_mag[ac_index] < 1
+            let falling_crossings=falling_crossings+1
+            if first_fall < 0
+                let first_fall=ac_index
+            end
+        end
+    end
+    let ac_index=ac_index+1
+end
+if first_fall > 0
+    let i_hi=first_fall
+    let i_lo=first_fall-1
+    if gain_mag[i_hi] > 0
+        let db_lo=20*log10(gain_mag[i_lo])
+        let db_hi=20*log10(gain_mag[i_hi])
+        let fraction=-db_lo/(db_hi-db_lo)
+        let ugf_hz=exp(log(frequency[i_lo])+fraction*(log(frequency[i_hi])-log(frequency[i_lo])))
+        set m_ugf=$&ugf_hz
+        if real(inverting_gain[0]) > 0
+            let phase_at_ugf_deg=phase_deg[i_lo]+fraction*(phase_deg[i_hi]-phase_deg[i_lo])
+            let phase_margin_deg=180+phase_at_ugf_deg
+            set m_pm=$&phase_margin_deg
+        else
+            echo PM unavailable: low-frequency loop polarity is not negative feedback.
+        end
+    end
+else
+    echo UGF/PM unavailable: no falling unity-gain crossing in the configured sweep.
+end
+print falling_crossings
+
+* CMRR: Vout=gp*VinP+gn*VinN; G=-gn, H=(gp+gn)/(1+G).
+* Hence ACM=H*(1+G), ADM=G+ACM/2, CMRR=|ADM/ACM|.
+let common_ripple=v(INP_CM)-v(CM_DC)
+let closed_cm_transfer=v(OUT_CM)/common_ripple
+let acm=closed_cm_transfer*(1+inverting_gain)
+let adm=inverting_gain+0.5*acm
+let adm_mag=mag(adm)
+let acm_mag=mag(acm)
+meas ac adm_ref_mag FIND adm_mag AT=$&cfg_ref_hz
+meas ac acm_ref_mag FIND acm_mag AT=$&cfg_ref_hz
+if adm_ref_mag > 0
+    if acm_ref_mag > 0
+        let cmrr_db=20*log10(adm_ref_mag/acm_ref_mag)
+        set m_cmrr=$&cmrr_db
+    else
+        set m_cmrr=inf
+    end
+end
+
+* PSRR follows the repository's follower-rejection convention.
+let plus_output_mag=mag(v(INP_P)-v(OUT_P))
+let minus_output_mag=mag(v(INP_N)-v(OUT_N))
+let plus_rail_mag=mag(v(VDD_P))
+let minus_rail_mag=mag(v(VSS_N))
+meas ac plus_out_ref FIND plus_output_mag AT=$&cfg_ref_hz
+meas ac minus_out_ref FIND minus_output_mag AT=$&cfg_ref_hz
+meas ac plus_rail_ref FIND plus_rail_mag AT=$&cfg_ref_hz
+meas ac minus_rail_ref FIND minus_rail_mag AT=$&cfg_ref_hz
+if plus_out_ref > 0
+    let psrr_plus_db=20*log10(plus_rail_ref/plus_out_ref)
+    set m_psrr_plus=$&psrr_plus_db
+else
+    set m_psrr_plus=inf
+end
+if minus_out_ref > 0
+    let psrr_minus_db=20*log10(minus_rail_ref/minus_out_ref)
+    set m_psrr_minus=$&psrr_minus_db
+else
+    set m_psrr_minus=inf
+end
+
+* Save completed DC/AC metrics before starting the transient analysis.
+echo "DC_Gain_dB,UGF_Hz,Phase_Margin_deg,CMRR_dB,PSRR_Plus_dB,PSRR_Minus_dB,Slew_Rise_V_us,Slew_Fall_V_us,Power_Quiescent_uW" > $result_file
+echo "$m_gain,$m_ugf,$m_pm,$m_cmrr,$m_psrr_plus,$m_psrr_minus,$m_slew_rise,$m_slew_fall,$m_power" >> $result_file
+
+tran $&cfg_tran_step $&cfg_tran_stop 0 $&cfg_tran_max_step
+let sr_output=v(OUT_SR)
+meas tran output_low AVG v(OUT_SR) FROM=$&cfg_low_start TO=$&cfg_low_stop
+meas tran output_high AVG v(OUT_SR) FROM=$&cfg_high_start TO=$&cfg_high_stop
+let output_swing=output_high-output_low
+let rise_t10=-1
+let rise_t90=-1
+let fall_t90=-1
+let fall_t10=-1
+
+if output_swing > cfg_min_swing
+    let level10=output_low+0.1*output_swing
+    let level90=output_low+0.9*output_swing
+    let tr_index=1
+    let tr_count=length(time)
+    * Restrict both ends of each crossing interval to its FIRST-edge window.
+    * Subsequent pulse periods cannot accidentally complete a missing edge.
+    while tr_index < tr_count
+        let v_before=sr_output[tr_index-1]
+        let v_after=sr_output[tr_index]
+        let t_before=time[tr_index-1]
+        let t_after=time[tr_index]
+        if t_before >= cfg_rise_start
+            if t_after <= cfg_rise_end
+                if v_after > v_before
+                    if rise_t10 < 0
+                        if v_before <= level10
+                            if v_after > level10
+                                let rise_t10=t_before+(level10-v_before)*(t_after-t_before)/(v_after-v_before)
+                            end
+                        end
+                    end
+                    if rise_t90 < 0
+                        if v_before <= level90
+                            if v_after > level90
+                                let rise_t90=t_before+(level90-v_before)*(t_after-t_before)/(v_after-v_before)
+                            end
+                        end
+                    end
+                end
+            end
+        end
+        if t_before >= cfg_fall_start
+            if t_after <= cfg_fall_end
+                if v_after < v_before
+                    if fall_t90 < 0
+                        if v_before >= level90
+                            if v_after < level90
+                                let fall_t90=t_before+(level90-v_before)*(t_after-t_before)/(v_after-v_before)
+                            end
+                        end
+                    end
+                    if fall_t10 < 0
+                        if v_before >= level10
+                            if v_after < level10
+                                let fall_t10=t_before+(level10-v_before)*(t_after-t_before)/(v_after-v_before)
+                            end
+                        end
+                    end
+                end
+            end
+        end
+        let tr_index=tr_index+1
+    end
+    if rise_t10 >= 0
+        if rise_t90 > rise_t10
+            let slew_rise_v_us=0.8*output_swing/(rise_t90-rise_t10)/1e6
+            set m_slew_rise=$&slew_rise_v_us
+        end
+    end
+    if fall_t90 >= 0
+        if fall_t10 > fall_t90
+            let slew_fall_v_us=0.8*output_swing/(fall_t10-fall_t90)/1e6
+            set m_slew_fall=$&slew_fall_v_us
+        end
+    end
+else
+    echo SR unavailable: reversed or negligible settled output swing.
+end
+print output_low output_high output_swing rise_t10 rise_t90 fall_t90 fall_t10
+
+* Final result: exactly one header and one nine-column row.
+echo "DC_Gain_dB,UGF_Hz,Phase_Margin_deg,CMRR_dB,PSRR_Plus_dB,PSRR_Minus_dB,Slew_Rise_V_us,Slew_Fall_V_us,Power_Quiescent_uW" > $result_file
+echo "$m_gain,$m_ugf,$m_pm,$m_cmrr,$m_psrr_plus,$m_psrr_minus,$m_slew_rise,$m_slew_fall,$m_power" >> $result_file
+echo Results saved to $result_file
+* Python creates the Excel workbook and a one-design-point WIDE CSV.
+* The matching exporter validates all 22 MOS devices and 23 design inputs.
+* If Python/openpyxl is unavailable, the raw DC file and metrics TXT remain usable.
+shell python3 two_stage_folded_opamp_export_excel.py --netlist two_stage_folded_opamp_all_metrics.cir
+quit
+.endc
+.end
