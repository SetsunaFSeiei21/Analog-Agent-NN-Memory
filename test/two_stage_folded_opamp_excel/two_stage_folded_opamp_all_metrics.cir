let op_xmp_bias_ref_cbd=@m.xdut_cm.xmp_bias_ref.msky130_fd_pr__pfet_01v8_lvt[cbd]
let op_xmp_bias_ref_cbs=@m.xdut_cm.xmp_bias_ref.msky130_fd_pr__pfet_01v8_lvt[cbs]
