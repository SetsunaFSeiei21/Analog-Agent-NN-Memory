let op_xmp_vb3_cgb=@m.xdut_cm.xmp_vb3.msky130_fd_pr__pfet_01v8_lvt[cgb]
let op_xmp_vb3_cdg=@m.xdut_cm.xmp_vb3.msky130_fd_pr__pfet_01v8_lvt[cdg]
let op_xmp_vb3_cdd=@m.xdut_cm.xmp_vb3.msky130_fd_pr__pfet_01v8_lvt[cdd]
