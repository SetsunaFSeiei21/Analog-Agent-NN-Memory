let op_xmp_bias_ref_cgb=@m.xdut_cm.xmp_bias_ref.msky130_fd_pr__pfet_01v8_lvt[cgb]
let op_xmp_bias_ref_cdg=@m.xdut_cm.xmp_bias_ref.msky130_fd_pr__pfet_01v8_lvt[cdg]
let op_xmp_bias_ref_cdd=@m.xdut_cm.xmp_bias_ref.msky130_fd_pr__pfet_01v8_lvt[cdd]
let op_xmp_bias_ref_cds=@m.xdut_cm.xmp_bias_ref.msky130_fd_pr__pfet_01v8_lvt[cds]
let op_xmp_bias_ref_cdb=@m.xdut_cm.xmp_bias_ref.msky130_fd_pr__pfet_01v8_lvt[cdb]
let op_xmp_bias_ref_csg=@m.xdut_cm.xmp_bias_ref.msky130_fd_pr__pfet_01v8_lvt[csg]
let op_xmp_bias_ref_csd=@m.xdut_cm.xmp_bias_ref.msky130_fd_pr__pfet_01v8_lvt[csd]
let op_xmp_bias_ref_css=@m.xdut_cm.xmp_bias_ref.msky130_fd_pr__pfet_01v8_lvt[css]
