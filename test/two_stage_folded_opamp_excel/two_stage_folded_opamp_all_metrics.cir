* XMP_VB3: native model state, already including m multiplicity.
let op_xmp_vb3_w=@m.xdut_cm.xmp_vb3.msky130_fd_pr__pfet_01v8_lvt[w]
let op_xmp_vb3_l=@m.xdut_cm.xmp_vb3.msky130_fd_pr__pfet_01v8_lvt[l]
let op_xmp_vb3_m=@m.xdut_cm.xmp_vb3.msky130_fd_pr__pfet_01v8_lvt[m]
