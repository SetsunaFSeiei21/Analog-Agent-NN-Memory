let op_xmbias_cdg=@m.xdut_cm.xmbias.msky130_fd_pr__nfet_01v8_lvt[cdg]
let op_xmbias_cdd=@m.xdut_cm.xmbias.msky130_fd_pr__nfet_01v8_lvt[cdd]
