let op_xmbias_cgs=@m.xdut_cm.xmbias.msky130_fd_pr__nfet_01v8_lvt[cgs]
let op_xmbias_cgd=@m.xdut_cm.xmbias.msky130_fd_pr__nfet_01v8_lvt[cgd]
