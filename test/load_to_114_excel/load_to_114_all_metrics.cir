let op_xnm8_csb=@m.xdut_cm.xnm8.msky130_fd_pr__nfet_01v8_lvt[csb]
let op_xnm8_cbg=@m.xdut_cm.xnm8.msky130_fd_pr__nfet_01v8_lvt[cbg]
let op_xnm8_cbd=@m.xdut_cm.xnm8.msky130_fd_pr__nfet_01v8_lvt[cbd]
