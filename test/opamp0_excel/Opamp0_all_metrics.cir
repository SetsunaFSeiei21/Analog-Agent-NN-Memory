* XPM7: one physical device instance including its m multiplicity.
let op_xpm7_w=@m.xdut_cm.xpm7.msky130_fd_pr__pfet_01v8_lvt[w]
let op_xpm7_l=@m.xdut_cm.xpm7.msky130_fd_pr__pfet_01v8_lvt[l]
let op_xpm7_m=@m.xdut_cm.xpm7.msky130_fd_pr__pfet_01v8_lvt[m]
