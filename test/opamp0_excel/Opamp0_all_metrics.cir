let op_xpm9_capbd=@m.xdut_cm.xpm9.msky130_fd_pr__pfet_01v8_lvt[capbd]
let op_xpm9_capbs=@m.xdut_cm.xpm9.msky130_fd_pr__pfet_01v8_lvt[capbs]
let op_xpm9_qg=@m.xdut_cm.xpm9.msky130_fd_pr__pfet_01v8_lvt[qg]
let op_xpm9_qb=@m.xdut_cm.xpm9.msky130_fd_pr__pfet_01v8_lvt[qb]
let op_xpm9_qd=@m.xdut_cm.xpm9.msky130_fd_pr__pfet_01v8_lvt[qd]
let op_xpm9_qs=@m.xdut_cm.xpm9.msky130_fd_pr__pfet_01v8_lvt[qs]

* XPM8: one physical device instance including its m multiplicity.
let op_xpm8_w=@m.xdut_cm.xpm8.msky130_fd_pr__pfet_01v8_lvt[w]
let op_xpm8_l=@m.xdut_cm.xpm8.msky130_fd_pr__pfet_01v8_lvt[l]
