+load_to_114 - single-file nine-metric ngspice testbench
+* ============================================================
+* Run: ngspice -b load_to_114_all_metrics.cir
+* Output: load_to_114_metrics.txt, in the current working directory.
+* The output has one CSV header and one row, although its suffix is .txt.
+* DUT and its 21 design parameters are embedded below; no params.sp needed.
+* DC operating point: XDUT_CM, one quiet voltage-follower instance.
+* Also keep load_to_114_export_excel.py in the current working directory.
+* Excel export needs Python 3 and openpyxl: python3 -m pip install openpyxl
+* Additional outputs: load_to_114_dc_operating_point.raw/.csv and load_to_114_results.xlsx.
+* The PDK remains external. Raw DC data is saved before AC/transient analysis.
+* Edit the PDK path, TEST CONDITIONS and DESIGN PARAMETERS before use.
+* Example dimensions below are not a verified golden point.
+*
+* Metric definitions follow the repository's single-ended-opamp benches:
+* gain: inverting-input AC injection, corrected for input sign, at 1 Hz;
+* UGF/PM: first falling unity-loop-gain crossing in the SAME AC sweep;
+* CMRR: reconstructed |ADM/ACM|, at 1 Hz;
+* PSRR: unity-follower rail rejection, at 1 Hz (repository convention);
+* SR: average 10%-90% settled OUTPUT transition slope, positive V/us;
+* power: DC rail power of ONE quiet follower instance, in uW.
+* Missing crossings/transitions are written as nan, never as zero.
+* Negative dB values and negative phase margins are retained.
+* ============================================================
+
+.param mc_mm_switch=0 mc_pr_switch=0
+.lib "/share/home/202411094934/python_project/pdk/sky130A/libs.tech/ngspice/sky130.lib.spice" tt
+.option scale=1u
+.options numdgt=15
+.temp 27
+
+* --------------------- TEST CONDITIONS -----------------------
+* W/L use um, current uses A, capacitor value uses F.
+.param SUPPLY_VDD=1.8 SUPPLY_VSS=0.0 INPUT_VCM=0.72 LOAD_C=1p
+.param AC_DENSITY=100 AC_START_HZ=0.1 AC_STOP_HZ=50e9 REF_HZ=1
+.param SR_LOW=0.7 SR_HIGH=1.1 SR_DELAY=1u
+.param SR_INPUT_TR=1n SR_INPUT_TF=1n SR_WIDTH=4u SR_PERIOD=10u
+.param TRAN_STEP=1n TRAN_STOP=12u TRAN_MAX_STEP=1n
+.param LOW_AVG_START=0.2u LOW_AVG_STOP=0.8u
+.param HIGH_AVG_START=3u HIGH_AVG_STOP=4u
+.param RISE_WINDOW_START=0.9u RISE_WINDOW_END=4.9u
+.param FALL_WINDOW_START=4.9u FALL_WINDOW_END=10.9u
+.param MIN_OUTPUT_SWING=1e-6
+
+* Copy .param values into control-language constants.
+.csparam cfg_ac_density={AC_DENSITY}
+.csparam cfg_ac_start={AC_START_HZ}
+.csparam cfg_ac_stop={AC_STOP_HZ}
+.csparam cfg_ref_hz={REF_HZ}
+.csparam cfg_tran_step={TRAN_STEP}
+.csparam cfg_tran_stop={TRAN_STOP}
+.csparam cfg_tran_max_step={TRAN_MAX_STEP}
+.csparam cfg_low_start={LOW_AVG_START}
+.csparam cfg_low_stop={LOW_AVG_STOP}
+.csparam cfg_high_start={HIGH_AVG_START}
+.csparam cfg_high_stop={HIGH_AVG_STOP}
+.csparam cfg_rise_start={RISE_WINDOW_START}
+.csparam cfg_rise_end={RISE_WINDOW_END}
+.csparam cfg_fall_start={FALL_WINDOW_START}
+.csparam cfg_fall_end={FALL_WINDOW_END}
+.csparam cfg_min_swing={MIN_OUTPUT_SWING}
+
+* -------------------- DESIGN PARAMETERS ----------------------
+* Independent snapshot of the 21-parameter load_to_114 netlist.
+* Harness test format: main ab6aad06c1e254a485b50d5b02d8b6267839a4a1.
+* load_to_114 itself has not yet been committed in that revision.
+* DUT source SHA256: f3a65f7bf63b554c4da5725a8f4351a7503f36173e703f254c47ec332ff542da
+* W/L: um; M: positive integer; CCOMP_F: F; IBIAS_A: A.
+* Default sizes are unverified starting values. Edit this snapshot here.
+
+* ============================================================
+* load_to_114_params.sp
+*
+* W/L     : um, without a u suffix
+* M       : dimensionless positive integer
+* CCOMP_F : F
+* IBIAS_A : A
+*
+* 21 independent parameters:
+*   8 W + 8 L + 3 M + CCOMP_F + IBIAS_A
+* Initial sizing values, not sampling limits.
+* Equal initial values do not bind independent parameters.
+* ============================================================
+
+* NMOS reference mirror: XNM1 / XNM7.
+.param DESVAR_W1=2
+.param DESVAR_L1=1
+
+* PMOS reference mirror: XPM5 / XPM17 / XPM18.
+.param DESVAR_W2=4
+.param DESVAR_L2=1
+
+* Tail reference, tail and output sink: XNM2 / XNM10 / XNM8.
+* W3/L3 remains independent of W1/L1.
+.param DESVAR_W3=2
+.param DESVAR_L3=1
+
+* Matched input differential pair: XNM12 / XNM13.
+.param DESVAR_W4=8
+.param DESVAR_L4=0.5
+
+* Matched NMOS cascode pair: XNM11 / XNM9.
+.param DESVAR_W5=8
+.param DESVAR_L5=0.5
+
+* First-stage PMOS mirror load: XPM6 / XPM16.
+.param DESVAR_W6=4
+.param DESVAR_L6=1
+
+* PMOS second-stage device: XPM15.
+.param DESVAR_W7=8
+.param DESVAR_L7=1
+
+* Independent cascode-bias device: XNM4.
+.param DESVAR_W8=0.5
+.param DESVAR_L8=1
+
+* Input-stage branch multiplier; the tail uses 1+2*M1.
+.param DESVAR_M1=1
+
+* Additional second-stage multiplier; XPM15/XNM8 use M1*M2.
+.param DESVAR_M2=4
+
+* Cascode-bias device multiplier; not a branch-current multiplier.
+.param DESVAR_M3=1
+
+* Miller compensation capacitor: 1 pF.
+.param CCOMP_F=1e-12
+
+* Reference current: 1 uA.
+.param IBIAS_A=1e-6
+
+* Resolved numeric inputs for the DC export; do not edit these aliases.
+.csparam export_desvar_w1={DESVAR_W1}
+.csparam export_desvar_l1={DESVAR_L1}
+.csparam export_desvar_w2={DESVAR_W2}
+.csparam export_desvar_l2={DESVAR_L2}
+.csparam export_desvar_w3={DESVAR_W3}
+.csparam export_desvar_l3={DESVAR_L3}
+.csparam export_desvar_w4={DESVAR_W4}
+.csparam export_desvar_l4={DESVAR_L4}
+.csparam export_desvar_w5={DESVAR_W5}
+.csparam export_desvar_l5={DESVAR_L5}
+.csparam export_desvar_w6={DESVAR_W6}
+.csparam export_desvar_l6={DESVAR_L6}
+.csparam export_desvar_w7={DESVAR_W7}
+.csparam export_desvar_l7={DESVAR_L7}
+.csparam export_desvar_w8={DESVAR_W8}
+.csparam export_desvar_l8={DESVAR_L8}
+.csparam export_desvar_m1={DESVAR_M1}
+.csparam export_desvar_m2={DESVAR_M2}
+.csparam export_desvar_m3={DESVAR_M3}
+.csparam export_ccomp_f={CCOMP_F}
+.csparam export_ibias_a={IBIAS_A}
+.csparam export_supply_vdd={SUPPLY_VDD}
+.csparam export_supply_vss={SUPPLY_VSS}
+.csparam export_input_vcm={INPUT_VCM}
+.csparam export_load_c={LOAD_C}
+.csparam export_ac_density={AC_DENSITY}
+.csparam export_ac_start_hz={AC_START_HZ}
+.csparam export_ac_stop_hz={AC_STOP_HZ}
+.csparam export_ref_hz={REF_HZ}
+.csparam export_sr_low={SR_LOW}
+.csparam export_sr_high={SR_HIGH}
+
+* DUT connectivity, sizing expressions and model names match the source.
+.subckt DUT VINP VINN VOUT VDD VSS
+
+* Reference current injected into the diode-connected NMOS.
+IBIAS_SRC VDD VBIAS DC {IBIAS_A}
+
+* NMOS reference mirror.
+XNM1 VBIAS VBIAS VSS VSS sky130_fd_pr__nfet_01v8_lvt W={DESVAR_W1} L={DESVAR_L1} m=1
+XNM7 N7 VBIAS VSS VSS sky130_fd_pr__nfet_01v8_lvt W={DESVAR_W1} L={DESVAR_L1} m=1
+
+* PMOS reference mirror: equal nominal branch currents.
+XPM5 N7 N7 VDD VDD sky130_fd_pr__pfet_01v8_lvt W={DESVAR_W2} L={DESVAR_L2} m=1
+XPM17 N2 N7 VDD VDD sky130_fd_pr__pfet_01v8_lvt W={DESVAR_W2} L={DESVAR_L2} m=1
+XPM18 N0 N7 VDD VDD sky130_fd_pr__pfet_01v8_lvt W={DESVAR_W2} L={DESVAR_L2} m=1
+
+* Tail-current reference and mirror.
+* The tail sinks the cascode-bias current plus both input currents.
+XNM2 N2 N2 VSS VSS sky130_fd_pr__nfet_01v8_lvt W={DESVAR_W3} L={DESVAR_L3} m=1
+XNM10 N1 N2 VSS VSS sky130_fd_pr__nfet_01v8_lvt W={DESVAR_W3} L={DESVAR_L3} m={1+2*DESVAR_M1}
+
+* Independently sized cascode-bias device.
+* M3 changes the bias voltage; XPM18 supplies the branch current.
+XNM4 N0 N0 N1 VSS sky130_fd_pr__nfet_01v8_lvt W={DESVAR_W8} L={DESVAR_L8} m={DESVAR_M3}
+
+* Matched input differential pair.
+XNM12 N4 VINN N1 VSS sky130_fd_pr__nfet_01v8_lvt W={DESVAR_W4} L={DESVAR_L4} m={DESVAR_M1}
+XNM13 N6 VINP N1 VSS sky130_fd_pr__nfet_01v8_lvt W={DESVAR_W4} L={DESVAR_L4} m={DESVAR_M1}
+
+* Matched NMOS cascode pair.
+XNM11 N3 N0 N4 VSS sky130_fd_pr__nfet_01v8_lvt W={DESVAR_W5} L={DESVAR_L5} m={DESVAR_M1}
+XNM9 N5 N0 N6 VSS sky130_fd_pr__nfet_01v8_lvt W={DESVAR_W5} L={DESVAR_L5} m={DESVAR_M1}
+
+* First-stage PMOS current-mirror load.
+XPM6 N3 N3 VDD VDD sky130_fd_pr__pfet_01v8_lvt W={DESVAR_W6} L={DESVAR_L6} m={DESVAR_M1}
+XPM16 N5 N3 VDD VDD sky130_fd_pr__pfet_01v8_lvt W={DESVAR_W6} L={DESVAR_L6} m={DESVAR_M1}
+
+* Second stage: PMOS common-source device and NMOS current sink.
+* XNM8 intentionally retains W3/L3 with its gate at VBIAS.
+* Its mirror ratio also depends on (W3/L3)/(W1/L1).
+XPM15 VOUT N5 VDD VDD sky130_fd_pr__pfet_01v8_lvt W={DESVAR_W7} L={DESVAR_L7} m={DESVAR_M2*DESVAR_M1}
+XNM8 VOUT VBIAS VSS VSS sky130_fd_pr__nfet_01v8_lvt W={DESVAR_W3} L={DESVAR_L3} m={DESVAR_M2*DESVAR_M1}
+
+* Miller compensation; capacitance is in farads.
+CC0 N5 VOUT {CCOMP_F}
+
+.ends DUT
+
+* -------- AC GAIN / UGF / PM: DC feedback, AC injection --------
+VDD_DM VDD_DM 0 DC {SUPPLY_VDD}
+VSS_DM VSS_DM 0 DC {SUPPLY_VSS}
+VINP_DM INP_DM 0 DC {INPUT_VCM}
+VINJ_DM SIGNAL_DM 0 DC {INPUT_VCM} AC 1
+LFB_DM OUT_DM INN_DM 1T
+CINJ_DM INN_DM SIGNAL_DM 1T
+XDUT_DM INP_DM INN_DM OUT_DM VDD_DM VSS_DM DUT
+CLOAD_DM OUT_DM VSS_DM {LOAD_C}
+
+* -------- CMRR: common-mode injection in a DC follower ---------
+* This instance also supplies the single-DUT DC power measurement.
+VDD_Q VDD_Q 0 DC {SUPPLY_VDD}
+VSS_Q VSS_Q 0 DC {SUPPLY_VSS}
+VCM_Q CM_DC 0 DC {INPUT_VCM}
+VCMAC_P INP_CM CM_DC DC 0 AC 1
+VCMAC_N INN_CM OUT_CM DC 0 AC 1
+XDUT_CM INP_CM INN_CM OUT_CM VDD_Q VSS_Q DUT
+CLOAD_CM OUT_CM VSS_Q {LOAD_C}
+
+* ------------------ POSITIVE-SUPPLY PSRR ----------------------
+VDD_P VDD_P 0 DC {SUPPLY_VDD} AC 1
+VSS_P VSS_P 0 DC {SUPPLY_VSS}
+VINP_P INP_P 0 DC {INPUT_VCM}
+XDUT_P INP_P OUT_P OUT_P VDD_P VSS_P DUT
+CLOAD_P OUT_P 0 {LOAD_C}
+
+* ------------------ NEGATIVE-SUPPLY PSRR ----------------------
+VDD_N VDD_N 0 DC {SUPPLY_VDD}
+VSS_N VSS_N 0 DC {SUPPLY_VSS} AC 1
+VINP_N INP_N 0 DC {INPUT_VCM}
+XDUT_N INP_N OUT_N OUT_N VDD_N VSS_N DUT
+CLOAD_N OUT_N 0 {LOAD_C}
+
+* ------------------ TRANSIENT SLEW RATE -----------------------
+VDD_SR VDD_SR 0 DC {SUPPLY_VDD}
+VSS_SR VSS_SR 0 DC {SUPPLY_VSS}
+VIN_SR IN_SR 0 DC {INPUT_VCM} PULSE({SR_LOW} {SR_HIGH} {SR_DELAY} {SR_INPUT_TR} {SR_INPUT_TF} {SR_WIDTH} {SR_PERIOD})
+XDUT_SR IN_SR OUT_SR OUT_SR VDD_SR VSS_SR DUT
+RLOAD_SR OUT_SR 0 1T
+CLOAD_SR OUT_SR 0 {LOAD_C}
+
+.control
+set noaskquit
+set units=radians
+set numdgt=15
+option numdgt=15
+set result_file=load_to_114_metrics.txt
+set m_gain=nan
+set m_ugf=nan
+set m_pm=nan
+set m_cmrr=nan
