@@ -0,0 +1,26 @@
+* Two-stage op amp design variables; one declaration per parameter.
+* IBIAS_A is amperes; RNULL_OHM is ohms; CCOMP_F is farads.
+* MOS W/L are numerical micrometers with the SKY130 PDK scale=1u option.
+* M is the positive integer number of parallel copies; default 1 preserves baseline.
+
+.param IBIAS_A=10e-6
+.param WBIAS=8
+.param LBIAS=0.5
+.param M_BIAS=1
+.param WIN=20
+.param LIN=0.5
+.param M_IN=1
+.param WLOAD=40
+.param LLOAD=0.5
+.param M_LOAD=1
+.param WTAIL=8
+.param LTAIL=0.5
+.param M_TAIL=1
+.param W2P=80
+.param L2P=0.5
+.param M_2P=1
+.param W2N=8
+.param L2N=0.5
+.param M_2N=1
+.param RNULL_OHM=10000
+.param CCOMP_F=1e-12
